---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 0 && (
    <aside class="toc" aria-label="สารบัญในบทนี้">
      <p class="toc-label">ในบทนี้</p>
      {items.map((h) => (
        <a href={`#${h.slug}`}>{h.text}</a>
      ))}
    </aside>
  )
}
